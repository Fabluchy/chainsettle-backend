# Secrets provider: env | aws | vault (default: env)
SECRETS_PROVIDER=env

# Comma-separated list of secret keys to resolve from the provider before config validation.
# Keys are read from the environment (env provider) or fetched from the secret manager
# (aws / vault) and injected into process.env. Values are cached and refreshed periodically.
SECRETS_KEYS=

# Refresh interval (ms) for rotated secrets. 0 disables refresh.
SECRETS_REFRESH_INTERVAL_MS=300000

# AWS Secrets Manager settings (used when SECRETS_PROVIDER=aws)
AWS_REGION=
AWS_SECRETS_PREFIX=

# HashiCorp Vault settings (used when SECRETS_PROVIDER=vault)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=

# Background job queues (BullMQ on REDIS_URL) — see docs/queues.md
QUEUE_PREFIX=chainsettle
QUEUE_METRICS_INTERVAL_MS=15000
# concurrency = parallel jobs per pod; attempts = total tries; backoff = exponential base delay (ms)
QUEUE_WEBHOOKS_CONCURRENCY=5
QUEUE_WEBHOOKS_ATTEMPTS=5
QUEUE_WEBHOOKS_BACKOFF_MS=5000
QUEUE_EMAILS_CONCURRENCY=3
QUEUE_EMAILS_ATTEMPTS=5
QUEUE_EMAILS_BACKOFF_MS=10000
QUEUE_EXPORTS_CONCURRENCY=2
QUEUE_EXPORTS_ATTEMPTS=3
QUEUE_EXPORTS_BACKOFF_MS=5000
